{
  "name": "werewolf-ai",
  "version": "1.5.2",
  "description": "AI 狼人杀 — 本地网页版，1 名人类玩家 + N 名 AI，OpenAI 兼容接口，运行时零依赖",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "lint": "node scripts/lint.js",
    "guards": "node scripts/check-guards.js",
    "hooks:install": "node scripts/install-hooks.js",
    "eslint": "eslint .",
    "format": "prettier --write",
    "coverage": "node scripts/coverage-gate.js",
    "eval": "node scripts/eval/eval-harness.js --games=30",
    "tmp:residue": "node scripts/tmp-residue-check.js",
    "gate": "npm run lint && npm run eslint && npm run coverage && npm run eval && npm run brand:check && npm run version:check && npm run guards && npm run e2e && npm run tmp:residue",
    "brand:apply": "node scripts/apply-brand-v2.js",
    "brand:check": "node scripts/check-brand-assets.js",
    "simulate": "node scripts/simulate.js",
    "bench:memory": "node scripts/memory-bench.js",
    "bench:pace": "node scripts/pace-bench.js",
    "probe:concurrency": "node scripts/probe-concurrency.js",
    "gen-docs": "node scripts/gen-roles-doc.js",
    "gen-icons": "node scripts/make-icons.js",
    "e2e": "node scripts/e2e.js",
    "ui:check": "node scripts/ui-check.js",
    "app:sync": "node scripts/build-app.js && cd app && npx cap sync android",
    "app:apk": "node scripts/build-apk.js",
    "app:verify": "node scripts/verify-packages.js",
    "app:win": "node scripts/build-win.js",
    "app:desktop": "node scripts/build-desktop.js",
    "playtest:fake": "node scripts/fake-llm.js",
    "playtest:report": "node scripts/playtest-report.js",
    "version:check": "node scripts/version-sync.js"
  },
  "engines": {
    "node": ">=18.18"
  },
  "license": "MIT",
  "devDependencies": {
    "eslint": "^10.10.0",
    "prettier": "^3.9.6"
  }
}

# 密钥与本机配置（模板见 config.example.json）
config.json

# 运行时产物
logs/
saves/
*.log

# 代玩测试工件
.play-state.json
.play-log*.md

# 本地浏览器验收快照与截图
.playwright-cli/
output/playwright/

# 依赖
node_modules/

# 构建产物：build-app.js / cap sync / gradle 生成，可用 npm run app:sync 重建
app/www/
app/android/.gradle/
app/android/build/
app/android/app/build/
app/android/app/src/main/assets/
app/android/capacitor-cordova-android-plugins/
app/android/local.properties
*.apk
*.keystore

# 电脑版打包产物：npm run app:win 生成（文件夹 + zip，含内置 node.exe，可重建）
release/

# 电脑版（Electron 桌面应用）：依赖与产物不入库，npm run app:desktop 重建
desktop/node_modules/
desktop/dist/

# 系统
.DS_Store
Thumbs.db

# 编辑器/工具临时产物。曾观察到某次编辑在 web/ 下短暂生成
# `<name>.<pid>.<uuid>.tmpdir/app.js.tmp`：它自己会消失，但只要有一次用
# `git add -A` 就会把它带进提交 —— 这类产物一律不入库，靠规则而不是靠纪律拦住。
*.tmpdir/
*.tmp
*~
*.orig
*.rej
*.bak
# 运行时数据目录（档案仓根与迁移目录）。**必须锚定到仓库根**：
# 不锚定的 `profiles/` 会连同源码目录 `src/profiles/` 一起忽略 —— 已跟踪的文件不受影响，
# 所以表面上一切正常，但**往 src/profiles/ 新增文件会被静默忽略、永远不会进提交**。
/profiles/
/migrations/
